{"ast":null,"code":"var __decorate = this && this.__decorate || function (decorators, target, key, desc) {\n  var c = arguments.length,\n    r = c < 3 ? target : desc === null ? desc = Object.getOwnPropertyDescriptor(target, key) : desc,\n    d;\n  if (typeof Reflect === \"object\" && typeof Reflect.decorate === \"function\") r = Reflect.decorate(decorators, target, key, desc);else for (var i = decorators.length - 1; i >= 0; i--) if (d = decorators[i]) r = (c < 3 ? d(r) : c > 3 ? d(target, key, r) : d(target, key)) || r;\n  return c > 3 && r && Object.defineProperty(target, key, r), r;\n};\nimport { Component, inject } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { ExportImportDataService } from '../../services/export-import-data.service';\nlet ShipmentTrackerComponent = class ShipmentTrackerComponent {\n  constructor() {\n    this.dataService = inject(ExportImportDataService);\n  }\n  onDivisionChange(event) {\n    const val = event.target.value;\n    this.dataService.selectedDivisionFilter.set(val);\n  }\n};\nShipmentTrackerComponent = __decorate([Component({\n  selector: 'app-shipment-tracker',\n  standalone: true,\n  imports: [CommonModule],\n  template: `\n    <section id=\"tracker\" class=\"py-16 bg-slate-950 border-b border-slate-900\">\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8\">\n        \n        <!-- Header -->\n        <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-4\">\n          <div>\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-2\">\n              Live Terminal Logistics\n            </div>\n            <h2 class=\"text-3xl font-extrabold text-white tracking-tight\">\n              Export Container & Import LC Terminal Tracker\n            </h2>\n            <p class=\"text-slate-400 text-sm mt-1\">\n              Real-time monitoring of outbound export shipments and inbound raw material cotton & dye consignments.\n            </p>\n          </div>\n\n          <!-- Currency Indicator Badge -->\n          <div class=\"flex items-center gap-3 bg-slate-900 px-4 py-2 rounded-xl border border-slate-800 text-xs\">\n            <span class=\"text-slate-400\">Display Currency:</span>\n            <span class=\"font-extrabold text-emerald-400 font-mono\">\n              {{ dataService.currentCurrency().code }} ({{ dataService.currentCurrency().symbol }})\n            </span>\n          </div>\n        </div>\n\n        <!-- Filter Bar -->\n        <div class=\"glass-panel p-4 rounded-2xl border border-slate-800 flex flex-col md:flex-row gap-4 items-center justify-between\">\n          \n          <!-- Type Filter Tabs -->\n          <div class=\"flex p-1 bg-slate-900 rounded-xl border border-slate-800 text-xs w-full md:w-auto\">\n            <button \n              (click)=\"dataService.selectedTypeFilter.set('ALL')\"\n              [class.bg-emerald-500]=\"dataService.selectedTypeFilter() === 'ALL'\"\n              [class.text-slate-950]=\"dataService.selectedTypeFilter() === 'ALL'\"\n              [class.text-slate-300]=\"dataService.selectedTypeFilter() !== 'ALL'\"\n              class=\"px-4 py-2 rounded-lg font-bold transition flex-1 md:flex-none\">\n              All Shipments\n            </button>\n            <button \n              (click)=\"dataService.selectedTypeFilter.set('EXPORT')\"\n              [class.bg-emerald-500]=\"dataService.selectedTypeFilter() === 'EXPORT'\"\n              [class.text-slate-950]=\"dataService.selectedTypeFilter() === 'EXPORT'\"\n              [class.text-slate-300]=\"dataService.selectedTypeFilter() !== 'EXPORT'\"\n              class=\"px-4 py-2 rounded-lg font-bold transition flex-1 md:flex-none\">\n              Outbound Exports\n            </button>\n            <button \n              (click)=\"dataService.selectedTypeFilter.set('IMPORT')\"\n              [class.bg-blue-500]=\"dataService.selectedTypeFilter() === 'IMPORT'\"\n              [class.text-slate-950]=\"dataService.selectedTypeFilter() === 'IMPORT'\"\n              [class.text-slate-300]=\"dataService.selectedTypeFilter() !== 'IMPORT'\"\n              class=\"px-4 py-2 rounded-lg font-bold transition flex-1 md:flex-none\">\n              Inbound Imports\n            </button>\n          </div>\n\n          <!-- Division Filter Dropdown -->\n          <div class=\"flex items-center gap-2 w-full md:w-auto\">\n            <label class=\"text-xs text-slate-400 font-medium hidden sm:inline\">Division:</label>\n            <select \n              [value]=\"dataService.selectedDivisionFilter()\"\n              (change)=\"onDivisionChange($event)\"\n              class=\"bg-slate-900 text-white border border-slate-700 text-xs rounded-xl px-3 py-2 focus:outline-none focus:border-emerald-500 w-full md:w-56\">\n              <option value=\"ALL\">All Group Divisions</option>\n              <option value=\"Knit Composite\">Keya Knit Composite</option>\n              <option value=\"Spinning\">Keya Spinning Mills</option>\n              <option value=\"Cosmetics\">Keya Cosmetics</option>\n              <option value=\"Cotton\">Keya Cotton Supply</option>\n            </select>\n          </div>\n\n        </div>\n\n        <!-- Shipments Table -->\n        <div class=\"glass-panel rounded-2xl border border-slate-800 overflow-hidden shadow-2xl\">\n          <div class=\"overflow-x-auto\">\n            <table class=\"w-full text-left text-xs\">\n              <thead class=\"bg-slate-900/90 border-b border-slate-800 text-slate-400 font-semibold uppercase tracking-wider\">\n                <tr>\n                  <th class=\"py-3.5 px-4\">Tracking & B/L ID</th>\n                  <th class=\"py-3.5 px-4\">Type & Division</th>\n                  <th class=\"py-3.5 px-4\">Buyer / Supplier</th>\n                  <th class=\"py-3.5 px-4\">Route (Origin → Destination)</th>\n                  <th class=\"py-3.5 px-4 text-right\">Contract Value</th>\n                  <th class=\"py-3.5 px-4\">Logistics Progress</th>\n                  <th class=\"py-3.5 px-4\">ETA</th>\n                </tr>\n              </thead>\n              <tbody class=\"divide-y divide-slate-800/60 font-medium\">\n                @for (shp of dataService.filteredShipments(); track shp.id) {\n                  <tr class=\"hover:bg-slate-900/60 transition\">\n                    \n                    <!-- Tracking IDs -->\n                    <td class=\"py-4 px-4 space-y-1\">\n                      <div class=\"flex items-center gap-2\">\n                        <span class=\"font-mono font-bold text-white text-sm\">{{ shp.id }}</span>\n                        <span class=\"px-1.5 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-300\">\n                          {{ shp.containerSize }}\n                        </span>\n                      </div>\n                      <div class=\"text-[11px] font-mono text-slate-400\">\n                        B/L: <span class=\"text-slate-200\">{{ shp.bolNumber }}</span>\n                      </div>\n                      <div class=\"text-[10px] font-mono text-slate-500\">\n                        LC: {{ shp.lcNumber }}\n                      </div>\n                    </td>\n\n                    <!-- Type & Division -->\n                    <td class=\"py-4 px-4 space-y-1\">\n                      <span \n                        [class.bg-emerald-500\\/10]=\"shp.type === 'EXPORT'\"\n                        [class.text-emerald-400]=\"shp.type === 'EXPORT'\"\n                        [class.border-emerald-500\\/30]=\"shp.type === 'EXPORT'\"\n                        [class.bg-blue-500\\/10]=\"shp.type === 'IMPORT'\"\n                        [class.text-blue-400]=\"shp.type === 'IMPORT'\"\n                        [class.border-blue-500\\/30]=\"shp.type === 'IMPORT'\"\n                        class=\"px-2 py-0.5 rounded-full text-[10px] font-extrabold border\">\n                        {{ shp.type }}\n                      </span>\n                      <div class=\"text-slate-300 font-semibold text-xs mt-1\">{{ shp.division }}</div>\n                      <div class=\"text-slate-400 text-[11px] line-clamp-1 max-w-xs\">{{ shp.itemsDescription }}</div>\n                    </td>\n\n                    <!-- Buyer / Supplier -->\n                    <td class=\"py-4 px-4\">\n                      <div class=\"font-semibold text-slate-100\">{{ shp.clientOrSupplier }}</div>\n                      <div class=\"text-[11px] text-slate-400 font-mono mt-0.5\">Qty: {{ shp.quantityUnits }}</div>\n                    </td>\n\n                    <!-- Route -->\n                    <td class=\"py-4 px-4 space-y-1 max-w-xs\">\n                      <div class=\"text-slate-300 font-medium truncate\">🛫 {{ shp.originPort }}</div>\n                      <div class=\"text-emerald-400 font-medium truncate\">🛬 {{ shp.destinationPort }}</div>\n                      <div class=\"text-[10px] text-slate-500\">Vessel: {{ shp.vesselName }}</div>\n                    </td>\n\n                    <!-- Value in Dynamic Currency -->\n                    <td class=\"py-4 px-4 text-right\">\n                      <div class=\"font-extrabold text-sm text-emerald-400 font-mono\">\n                        {{ dataService.formatValue(shp.valueUSD) }}\n                      </div>\n                      <div class=\"text-[10px] text-slate-500 font-mono\">\n                        \\${{ shp.valueUSD.toLocaleString() }} USD\n                      </div>\n                    </td>\n\n                    <!-- Status Progress Bar -->\n                    <td class=\"py-4 px-4 space-y-1.5 w-44\">\n                      <div class=\"flex items-center justify-between text-[11px]\">\n                        <span \n                          [class.text-emerald-400]=\"shp.status === 'Delivered' || shp.status === 'Loaded at Sea'\"\n                          [class.text-amber-400]=\"shp.status === 'In Transit'\"\n                          [class.text-blue-400]=\"shp.status === 'Port Customs Clear'\"\n                          class=\"font-semibold\">\n                          {{ shp.status }}\n                        </span>\n                        <span class=\"text-slate-400 font-mono text-[10px]\">{{ shp.progressPercentage }}%</span>\n                      </div>\n                      <div class=\"w-full bg-slate-900 h-1.5 rounded-full overflow-hidden border border-slate-800\">\n                        <div \n                          [style.width.%]=\"shp.progressPercentage\"\n                          [class.bg-emerald-500]=\"shp.status === 'Delivered' || shp.status === 'Loaded at Sea'\"\n                          [class.bg-amber-500]=\"shp.status === 'In Transit'\"\n                          [class.bg-blue-500]=\"shp.status === 'Port Customs Clear'\"\n                          class=\"h-full rounded-full transition-all duration-500\">\n                        </div>\n                      </div>\n                    </td>\n\n                    <!-- ETA -->\n                    <td class=\"py-4 px-4 font-mono text-slate-200\">\n                      {{ shp.eta }}\n                    </td>\n\n                  </tr>\n                }\n              </tbody>\n            </table>\n\n            @if (dataService.filteredShipments().length === 0) {\n              <div class=\"py-12 text-center text-slate-400 space-y-2\">\n                <p class=\"text-base font-medium\">No matching shipments found.</p>\n                <p class=\"text-xs text-slate-500\">Try clearing your search query or selecting \"All Shipments\".</p>\n              </div>\n            }\n          </div>\n        </div>\n\n      </div>\n    </section>\n  `\n})], ShipmentTrackerComponent);\nexport { ShipmentTrackerComponent };","map":null,"metadata":{},"sourceType":"module","externalDependencies":[]}